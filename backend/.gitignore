# Python Virtual Environment (DO NOT commit — too large)
.venv/

# Trained model weights (too large for Git — use Git LFS or share separately)
/app/ml/weights/*.pt
/app/ml/weights/*.onnx
/app/ml/weights/*.onnx.data
/data/checkpoints/
/data/metadata/tmp*

# Dataset images (can be very large)
/data/raw/
/data/processed/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables
.env

# OS files
.DS_Store
Thumbs.db
