{
  "expo": {
    "name": "LumbrScan",
    "slug": "lumbrscan",
    "scheme": "lumbrscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pejayy10.lumbrscan",
      "adaptiveIcon": {
        "backgroundColor": "#F4F6F8",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "backgroundColor": "#F4F6F8",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "LumbrScan needs access to your photo library to select timber images for species identification.",
          "cameraPermission": "LumbrScan needs access to your camera to capture timber images for species identification."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0496feb6-7191-4651-878f-3e18db367d12"
      }
    },
    "owner": "frandesa"
  }
}
